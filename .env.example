# Secrets for tools/swepipe.py and tools/cloud_agent.py.  Copy to .env (git-ignored, chmod 600).
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Usually in pipeline.toml, but may be overridden here:
# FEISHU_BASE_TOKEN=...
# FEISHU_TABLE_ID=...

# GitHub: leave GITHUB_TOKEN unset to use the account from `gh auth login`;
# set it (a token of the owner account or an org member) to publish as someone else.
# GITHUB_OWNER=your-github-user-or-org   # default: the account from `gh auth login`
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional x86_64 verification host (tools/cloud_agent.py)
# CLOUD_AGENT_URL=https://agent.example.com
# CLOUD_AGENT_TOKEN=...
# uv cannot reach pypi.org from some networks (TLS EOF); point it at a mirror for gen's pin resolution
# UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
